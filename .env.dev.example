# Local development only. `task setup` copies this to .env.dev.
# Never commit .env.dev. Cloud credentials do not belong here.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/workerbee
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/workerbee_test

BETTER_AUTH_SECRET=change-me-run-task-setup-to-generate-a-secret
BETTER_AUTH_URL=http://localhost:5173
PORT=3001

# Optional PostHog project. Leave the key empty to disable analytics, error
# tracking, and logs. The project token is publishable, not a secret.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workerbee
POSTGRES_TEST_DB=workerbee_test

# Override if you do not use Docker Compose.
# CONTAINER_CMD="podman compose"
