# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# Or pass these as TF_VAR_* environment variables in CI.
#
# The Neon API key is not here. Set it in the environment:
#   export NEON_API_KEY=...
# Find the organization id in the Neon console under Account settings.

account_id           = "00000000000000000000000000000000"
cloudflare_api_token = "replace-me"
neon_org_id          = "org-example-00000000"

# Optional overrides.
# neon_region = "aws-eu-central-1"
# name_prefix = "workerbee-dev"
